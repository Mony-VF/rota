{
  "manifest_version": 3,
  "name": "Verifone Rota Updater",
  "version": "1.0",
  "description": "Fetches the UK Rota page and sends it to the rota viewer",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://supportapi.verifone.co.il/*",
    "https://mony-vf.github.io/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rota Updater"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
